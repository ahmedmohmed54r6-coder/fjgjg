rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /devices/{deviceUid} {
      allow create, read, update, delete: if request.auth != null
                                          && request.auth.uid == deviceUid;

      match /owners/{ownerUid} {
        allow read, write: if request.auth != null && request.auth.uid == deviceUid;
      }

      match /viewers/{viewerUid} {
        allow read: if request.auth != null
                    && (request.auth.uid == deviceUid || request.auth.uid == viewerUid);
        allow create, update, delete: if request.auth != null
                                      && request.auth.uid == deviceUid;
      }
    }

    match /locations/{ownerUid} {
      allow create, update, delete: if request.auth != null && request.auth.uid == ownerUid;
      allow read: if request.auth != null
                  && (request.auth.uid == ownerUid
                      || exists(/databases/$(database)/documents/devices/$(ownerUid)/viewers/$(request.auth.uid)));
    }

    match /media/{ownerUid} {
      allow read: if request.auth != null
                  && (request.auth.uid == ownerUid
                      || exists(/databases/$(database)/documents/devices/$(ownerUid)/viewers/$(request.auth.uid)));
      allow create, update: if request.auth != null
                  && (request.auth.uid == ownerUid
                      || exists(/databases/$(database)/documents/devices/$(ownerUid)/viewers/$(request.auth.uid)));
      allow delete: if request.auth != null && request.auth.uid == ownerUid;
    }

    match /pairings/{code} {
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && code.size() == 8
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['ownerUid', 'ownerName', 'expiresAt', 'claimedBy', 'claimerName'])
        && request.resource.data.claimedBy == null
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt <= request.time + duration.value(15, 'm');
      allow update: if request.auth != null
        && resource.data.claimedBy == null
        && resource.data.expiresAt > request.time
        && request.auth.uid != resource.data.ownerUid
        && request.resource.data.claimedBy == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimedBy', 'claimerName']);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
